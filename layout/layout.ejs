<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">

<%- partial('partial/head', { page: page, config: config, theme: theme }) %>

<body hx-boost="true"
      hx-target=".main-content"
      hx-select=".main-content"
      hx-swap="outerHTML show:window:top"
      hx-push-url="true"
      hx-indicator="#htmx-indicator">

  <!-- htmx loading indicator -->
  <div id="htmx-indicator" class="htmx-indicator"></div>

  <!-- SVG Icon Sprite (once per page) -->
  <%- partial('partial/sprite') %>

  <!-- Background Layer -->
  <div class="fallback-bg"></div>
  <img id="bg-canvas-back" src="<%= url_for(theme.backgrounds[0]) %>" alt="" crossorigin="anonymous">
  <img id="bg-canvas" src="<%= url_for(theme.backgrounds[0]) %>" alt="Background" crossorigin="anonymous">

  <!-- Background Rotation Controls -->
  <% if (theme.backgrounds && theme.backgrounds.length > 1) { %>
  <div class="bg-controls" id="bg-controls">
    <button class="bg-arrow bg-prev" id="bg-prev" title="上一张">
      <svg class="sym-icon" aria-hidden="true"><use href="#chevron_left"/></svg>
    </button>
    <div class="bg-dots" id="bg-dots"></div>
    <button class="bg-arrow bg-next" id="bg-next" title="下一张">
      <svg class="sym-icon" aria-hidden="true"><use href="#chevron_right"/></svg>
    </button>
  </div>
  <% } %>

  <div class="site-wrapper">
    <!-- Header -->
    <%- partial('partial/header', { config: config, theme: theme, page: page }) %>

    <!-- Main Content -->
    <main class="main-content">
      <%- body %>
    </main>

    <!-- Sidebar (desktop) -->
    <%- partial('partial/sidebar', { config: config, theme: theme, page: page, site: site }) %>

    <!-- Footer -->
    <%- partial('partial/footer', { config: config, theme: theme }) %>
  </div>

  <!-- Scroll to Top -->
  <% if (theme.scroll_to_top) { %>
  <button id="scroll-to-top" class="scroll-to-top" title="回到顶部">
    <svg class="sym-icon" aria-hidden="true"><use href="#arrow_upward"/></svg>
  </button>
  <% } %>

  <!-- Background Images Config (passed to JS) -->
  <script id="bg-config" type="application/json">
    <%- JSON.stringify(theme.backgrounds ? theme.backgrounds.map(function(bg) { return url_for(bg); }) : []) %>
  </script>

  <!-- Utterances global config (always available for PJAX re-init) -->
  <% if (theme.comment_system === 'utterances' && theme.utterances && theme.utterances.enable) { %>
  <script>
    window._utterancesConfig = {
      repo: '<%= theme.utterances.repo %>',
      issueTerm: '<%= theme.utterances.issue_term %>',
      label: '<%= theme.utterances.label %>',
      theme: '<%= theme.utterances.theme %>'
    };
    window._initUtterances = function() {
      var el = document.getElementById('utterances-container');
      if (!el) return;
      el.innerHTML = '';
      var script = document.createElement('script');
      script.src = 'https://utteranc.es/client.js';
      script.setAttribute('repo', window._utterancesConfig.repo);
      script.setAttribute('issue-term', window._utterancesConfig.issueTerm);
      if (window._utterancesConfig.label) {
        script.setAttribute('label', window._utterancesConfig.label);
      }
      script.setAttribute('theme', window._utterancesConfig.theme);
      script.crossOrigin = 'anonymous';
      script.async = true;
      el.appendChild(script);
    };
  </script>
  <% } %>

  <!-- Comment System JS init (always available for PJAX re-init) -->
  <% if (theme.comment_system === 'gitalk' && theme.gitalk && theme.gitalk.enable) { %>
  <script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js"></script>
  <script>
    window._gitalkBase = {
      clientID: '<%= theme.gitalk.clientID %>',
      clientSecret: '<%= theme.gitalk.clientSecret %>',
      repo: '<%= theme.gitalk.repo %>',
      owner: '<%= theme.gitalk.owner %>',
      admin: <%- JSON.stringify(theme.gitalk.admin) %>,
      distractionFreeMode: <%= theme.gitalk.distractionFreeMode || false %>,
      createIssueManually: <%= theme.gitalk.createIssueManually !== false %>,
      labels: <%- JSON.stringify(theme.gitalk.labels || ['Gitalk']) %>,
    };
    window._initGitalk = function() {
      var container = document.getElementById('gitalk-container');
      if (!container) return;
      var pageId = container.getAttribute('data-id');
      if (!pageId) return;
      container.innerHTML = '';
      var config = Object.assign({}, window._gitalkBase, { id: pageId });
      new Gitalk(config).render('gitalk-container');
    };
  </script>
  <% } %>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2/dist/htmx.min.js"></script>
  <script src="<%= url_for('js/dynamic-color.js') %>"></script>
  <script src="<%= url_for('js/main.js') %>"></script>
  <script src="<%= url_for('js/pjax.js') %>"></script>
</body>

</html>
