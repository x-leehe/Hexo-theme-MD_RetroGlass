<!-- ============================================================
  MD-RetroGlass — Single post page
  ============================================================ -->
<article class="post-full">
  <div class="post-full-inner">
    <!-- Post Header -->
    <header class="post-full-header">
      <h1 class="post-full-title"><%= page.title %></h1>

      <div class="post-full-meta">
        <!-- Date -->
        <span class="post-meta-item">
          <svg class="sym-icon" aria-hidden="true"><use href="#calendar_today"/></svg>
          <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>">
            <%= date(page.date, theme.post.date_format || 'YYYY-MM-DD') %>
          </time>
        </span>

        <!-- Updated -->
        <% if (page.updated && page.updated !== page.date) { %>
        <span class="post-meta-item">
          <svg class="sym-icon" aria-hidden="true"><use href="#edit"/></svg>
          <time datetime="<%= date(page.updated, 'YYYY-MM-DD') %>">
            <%= date(page.updated, theme.post.date_format || 'YYYY-MM-DD') %>
          </time>
        </span>
        <% } %>

        <!-- Reading Time -->
        <% if (theme.post.reading_time) { %>
        <span class="post-meta-item">
          <svg class="sym-icon" aria-hidden="true"><use href="#schedule"/></svg>
          <span><%= Math.max(1, Math.ceil(page.content.replace(/<[^>]*>/g, '').length / 500)) %> min read</span>
        </span>
        <% } %>

        <!-- Word Count -->
        <span class="post-meta-item">
          <svg class="sym-icon" aria-hidden="true"><use href="#text_fields"/></svg>
          <span><%= page.content.replace(/<[^>]*>/g, '').length %> chars</span>
        </span>
      </div>

      <!-- Categories -->
      <% if (page.categories && page.categories.length > 0) { %>
      <div class="post-full-categories">
        <svg class="sym-icon" aria-hidden="true"><use href="#folder"/></svg>
        <% page.categories.forEach(function(cat) { %>
        <a href="<%= url_for(cat.path) %>" class="category-link"><%= cat.name %></a>
        <% }); %>
      </div>
      <% } %>

      <!-- Tags -->
      <% if (page.tags && page.tags.length > 0) { %>
      <div class="post-full-tags">
        <% page.tags.forEach(function(tag) { %>
        <a href="<%= url_for(tag.path) %>" class="post-tag-chip">
          <svg class="sym-icon" aria-hidden="true"><use href="#tag"/></svg>
          <%= tag.name %>
        </a>
        <% }); %>
      </div>
      <% } %>
    </header>

    <!-- Table of Contents -->
    <% if (theme.toc && theme.toc.enable && page.toc !== false) { %>
    <div class="post-toc">
      <details class="toc-details">
        <summary class="toc-summary">
          <svg class="sym-icon" aria-hidden="true"><use href="#toc"/></svg>
          <span>目录</span>
        </summary>
        <div class="toc-body">
          <%- toc(page.content, { list_number: theme.toc.list_number, max_depth: theme.toc.max_depth }) %>
        </div>
      </details>
    </div>
    <% } %>

    <!-- Post Content -->
    <div class="post-full-content">
      <%- page.content %>
    </div>

    <!-- Post Footer -->
    <footer class="post-full-footer">
      <!-- Previous / Next Navigation -->
      <nav class="post-nav">
        <% if (page.prev) { %>
        <a href="<%= url_for(page.prev.path) %>" class="post-nav-item post-nav-prev">
          <span class="post-nav-label">
            <svg class="sym-icon" aria-hidden="true"><use href="#chevron_left"/></svg>
            <span>Previous</span>
          </span>
          <span class="post-nav-title"><%= page.prev.title %></span>
        </a>
        <% } %>
        <% if (page.next) { %>
        <a href="<%= url_for(page.next.path) %>" class="post-nav-item post-nav-next">
          <span class="post-nav-label">
            <span>Next</span>
            <svg class="sym-icon" aria-hidden="true"><use href="#chevron_right"/></svg>
          </span>
          <span class="post-nav-title"><%= page.next.title %></span>
        </a>
        <% } %>
      </nav>
    </footer>
  </div>
</article>

<!-- Gitalk Comments -->
<%- partial('partial/gitalk', { page: page, theme: theme }) %>
