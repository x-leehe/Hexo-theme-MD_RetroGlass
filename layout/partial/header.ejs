<!-- ============================================================
  MD-RetroGlass — Header partial
  ============================================================ -->
<header class="site-header">
  <div class="header-inner">
    <!-- Left group: back button + logo -->
    <div class="header-left">
      <!-- Back button — visibility toggled by JS (htmx-compatible) -->
      <a class="header-back-btn"
         href="<%= url_for('/') %>"
         onclick="if(document.referrer&&document.referrer.includes(location.host)){history.back();return false}"
         title="返回"
         aria-label="返回">
        <svg class="sym-icon" aria-hidden="true"><use href="#arrow_back"/></svg>
      </a>

      <!-- Logo / Site Title -->
      <a href="<%= url_for('/') %>" class="site-logo">
        <span class="logo-text">
          <span class="logo-title"><%= config.title %></span>
        </span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="nav-desktop">
      <div class="nav-indicator" id="nav-indicator"></div>
      <% for (var item in theme.menu) { %>
        <a href="<%= url_for(theme.menu[item]) %>"
           class="nav-item<%= (page.path === theme.menu[item] || (theme.menu[item] !== '/' && page.path.startsWith(theme.menu[item]))) ? ' active' : '' %>">
          <%= item %>
        </a>
      <% } %>
    </nav>

    <!-- Theme Toggle Button -->
    <button class="header-theme-btn" id="theme-toggle" title="切换配色方案" aria-label="切换配色方案">
      <svg class="sym-icon icon-dark" aria-hidden="true"><use href="#dark_mode"/></svg>
      <svg class="sym-icon icon-light" aria-hidden="true"><use href="#light_mode"/></svg>
      <svg class="sym-icon icon-auto" aria-hidden="true"><use href="#moon_stars"/></svg>
      <svg class="sym-icon icon-time" aria-hidden="true"><use href="#brightness_auto"/></svg>
    </button>

    <!-- Mobile Menu Toggle -->
    <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="菜单">
      <svg class="sym-icon" aria-hidden="true"><use href="#menu"/></svg>
    </button>
  </div>

  <!-- Mobile Navigation Overlay -->
  <nav class="nav-mobile" id="nav-mobile">
    <% for (var item in theme.menu) { %>
      <a href="<%= url_for(theme.menu[item]) %>"
         class="nav-item-mobile<%= (page.path === theme.menu[item] || (theme.menu[item] !== '/' && page.path.startsWith(theme.menu[item]))) ? ' active' : '' %>">
        <%= item %>
      </a>
    <% } %>
  </nav>
</header>
