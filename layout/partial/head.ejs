<!-- ============================================================
  MD-RetroGlass — <head> partial
  ============================================================ -->
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <!-- Anti-FOUC: apply theme before any CSS paints -->
  <script>
    (function(){try{const s=localStorage.getItem('color-scheme');if(s==='time-based')s='time';if(s==='light'){document.documentElement.classList.add('light-mode');}else if(s==='auto'||s===null){if(window.matchMedia&&window.matchMedia('(prefers-color-scheme: light)').matches){document.documentElement.classList.add('light-mode');}}else if(s==='time'){const h=new Date().getHours();if(h>=6&&h<18){document.documentElement.classList.add('light-mode');}}}catch(e){}})();
  </script>
  <!-- Fallback: show body if JS is disabled -->
  <noscript><style>body{visibility:visible}</style></noscript>

  <!-- Title -->
  <title>
    <% if (is_home()) { %>
      <%= config.title %>
    <% } else if (is_post()) { %>
      <%= page.title %> — <%= config.title %>
    <% } else if (is_archive()) { %>
      Archives — <%= config.title %>
    <% } else if (is_tag()) { %>
      Tag: <%= page.tag %> — <%= config.title %>
    <% } else if (is_category()) { %>
      Category: <%= page.category %> — <%= config.title %>
    <% } else { %>
      <%= page.title %> — <%= config.title %>
    <% } %>
  </title>

  <!-- SEO -->
  <% if (theme.seo && theme.seo.robots) { %>
  <meta name="robots" content="<%= theme.seo.robots %>">
  <% } %>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta name="author" content="<%= config.author %>">

  <!-- Open Graph -->
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= page.description || config.description %>">
  <meta property="og:url" content="<%= full_url_for(page.path) %>">
  <meta property="og:site_name" content="<%= config.title %>">

  <!-- Favicon -->
  <% if (theme.favicon) { %>
  <link rel="icon" type="image/png" href="<%= url_for(theme.favicon) %>">
  <% } %>

  <!-- Fonts (self-hosted, see _variables.scss @font-face) -->

  <!-- PrismJS (dark theme default, light theme disabled) -->
  <link rel="stylesheet" id="prism-dark" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.css">
  <link rel="stylesheet" id="prism-light" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.css" disabled>

  <!-- Theme Stylesheet -->
  <link rel="stylesheet" href="<%= url_for('css/style.css') %>">

  <!-- Preload background -->
  <% if (theme.backgrounds && theme.backgrounds.length > 0) { %>
  <link rel="preload" as="image" href="<%= url_for(theme.backgrounds[0]) %>" crossorigin="anonymous">
  <% } %>

  <!-- Focus-title: dynamic tab title on visibility change — loaded dynamically via main.js -->
</head>
