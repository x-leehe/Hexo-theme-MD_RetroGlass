<!-- ============================================================
  MD-RetroGlass — Footer partial
  ============================================================ -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span>&copy; <%= theme.footer.since %>–<%= date(Date.now(), 'YYYY') %> <%= theme.footer.copyright || config.author %></span>
      <% if (theme.footer.icp) { %>
      <span class="footer-icp"><%- theme.footer.icp %></span>
      <% } %>
      <% if (theme.footer.custom_html) { %>
      <span class="footer-custom"><%- theme.footer.custom_html %></span>
      <% } %>
    </div>
    <div class="footer-right">
      <% if (theme.footer.powered_by) { %>
      <span>Powered by <a href="https://hexo.io/" target="_blank" rel="noopener">Hexo</a></span>
      <span class="footer-sep">|</span>
      <% } %>
      <span>Theme <a href="https://github.com/x-leehe/Hexo-theme-MD_RetroGlass" target="_blank" rel="noopener">MD-RetroGlass</a></span>
    </div>
  </div>
</footer>
