<!-- ============================================================
  MD-RetroGlass — Gitalk comments partial
  ============================================================ -->
<% if (theme.gitalk && theme.gitalk.enable && page.comments !== false) { %>
<section class="comments-section">
  <div class="comments-container">
    <h3 class="comments-title">
      <svg class="sym-icon" aria-hidden="true"><use href="#chat"/></svg>
      <span>Comments</span>
    </h3>
    <div id="gitalk-container" data-id="<%= page.path.replace(/index\.html$/, '') %>"></div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.css">
<script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js"></script>
<script>
  (function() {
    // Initial load
    if (typeof Gitalk !== 'undefined') {
      window._initGitalk();
    } else {
      window.addEventListener('load', function() {
        setTimeout(window._initGitalk, 300);
      });
    }
  })();
</script>
<% } %>
