<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">
<script src="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@xizeyoupan/meting@latest/dist/Meting.min.js"></script>
<meting-js
  server="<%= theme.music.server %>"
  type="<%= theme.music.type %>"
  id="<%= theme.music.id %>"
  <% if (theme.music.api) { %>api="<%- theme.music.api %>"<% } %>
  <% if (theme.music.list_folded) { %>list-folded="true"<% } %>>
</meting-js>
